NODE_ENV=development
PORT=4000
AGENT_RUNTIME_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOW_LOCAL_FALLBACK=true
AUTH_MODE=demo
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://localhost:27017/eduswarm
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=eduswarm_knowledge
SESSION_SECRET=replace-with-a-long-random-value
# Same key on both services: the API calls the model directly whenever the
# agent runtime is asleep, so specialists never silently degrade to canned text.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=inclusionai/ling-3.0-flash-vl:free,qwen/qwen3.8-27b:free,deepseek/deepseek-v4-flash:free,thinkingmachines/inkling-small:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=240000
# Bound structured lesson output; compact notes + practice are generated in one call.
OPENROUTER_STRUCTURED_MAX_TOKENS=2200
# Structured lessons use a function-call JSON envelope and can try up to four current free models.
# Each failed provider attempt is capped at two minutes to stay inside job recovery limits.
OPENROUTER_REQUEST_TIMEOUT_SECONDS=120
OPENROUTER_STRUCTURED_MAX_MODELS=4
OPENROUTER_STRUCTURED_RETRY_BACKOFF_SECONDS=2
# API waits up to ten minutes for the runtime job before using the local companion.
AGENT_RUNTIME_TIMEOUT_MS=30000
AGENT_RUNTIME_MAX_WAIT_MS=600000
AGENT_CHAT_TIMEOUT_MS=240000
VITE_API_URL=http://localhost:4000
