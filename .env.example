NODE_ENV=development
PORT=4000
AGENT_RUNTIME_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOW_LOCAL_FALLBACK=true
AUTH_MODE=demo
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://localhost:27017/eduswarm
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=eduswarm_knowledge
# Offline evidence tier: seeded local study kits (see seed_knowledge.py --local-kits).
EDUSWARM_LOCAL_KITS_DIR=/tmp/eduswarm-local-kits
SESSION_SECRET=replace-with-a-long-random-value
# Same key on both services: the API calls the model directly whenever the
# agent runtime is asleep, so specialists never silently degrade to canned text.
OPENROUTER_API_KEY=
# The only AI setting that matters. Models, token budgets, timeouts and retries
# are all chosen by the code from OpenRouter's live catalogue — there is nothing
# else to configure and nothing to update when a free model dies.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: one cheap PAID model, tried only after every free model has failed.
# Leave empty to stay entirely on the free tier.
OPENROUTER_PAID_FALLBACK_MODEL=
# API waits up to ten minutes for the runtime job before using the local companion.
AGENT_RUNTIME_TIMEOUT_MS=30000
AGENT_RUNTIME_MAX_WAIT_MS=600000
AGENT_CHAT_TIMEOUT_MS=240000
VITE_API_URL=http://localhost:4000
