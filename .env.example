NODE_ENV=development
PORT=4000
AGENT_RUNTIME_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOW_LOCAL_FALLBACK=true
AUTH_MODE=demo
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://localhost:27017/eduswarm
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=eduswarm_knowledge
SESSION_SECRET=replace-with-a-long-random-value
# Same key on both services: the API calls the model directly whenever the
# agent runtime is asleep, so specialists never silently degrade to canned text.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free,openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=90000
VITE_API_URL=http://localhost:4000
