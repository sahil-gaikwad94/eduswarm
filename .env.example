NODE_ENV=development
PORT=4000
AGENT_RUNTIME_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOW_LOCAL_FALLBACK=true
AUTH_MODE=demo
PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://localhost:27017/eduswarm
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=eduswarm_knowledge
# Offline evidence tier: seeded local study kits (see seed_knowledge.py --local-kits).
EDUSWARM_LOCAL_KITS_DIR=/tmp/eduswarm-local-kits
SESSION_SECRET=replace-with-a-long-random-value
# Same key on both services: the API calls the model directly whenever the
# agent runtime is asleep, so specialists never silently degrade to canned text.
OPENROUTER_API_KEY=
# OPTIONAL HINTS ONLY. The model chain is discovered from OpenRouter's live
# catalogue, so leaving these empty is the recommended setting: a stale id here
# is ignored once it disappears from the catalogue, and can never cause an
# outage. Set them only to pin a preferred model you know is live.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-attempt timeout for a direct API chat (the runtime uses its own budgets).
LLM_TIMEOUT_MS=75000
# Lesson output budget. A full lesson is ~3k tokens; smaller values truncate the
# JSON. Values outside 3000-6000 are clamped in code.
OPENROUTER_STRUCTURED_MAX_TOKENS=4096
# Per-attempt timeout and how many models one lesson may walk (clamped 4-10).
OPENROUTER_REQUEST_TIMEOUT_SECONDS=150
OPENROUTER_STRUCTURED_MAX_MODELS=6
# Optional reliability tier: one cheap PAID model, tried only after every free
# model has failed. Leave empty to stay entirely on the free tier.
OPENROUTER_PAID_FALLBACK_MODEL=
# API waits up to ten minutes for the runtime job before using the local companion.
AGENT_RUNTIME_TIMEOUT_MS=30000
AGENT_RUNTIME_MAX_WAIT_MS=600000
AGENT_CHAT_TIMEOUT_MS=240000
VITE_API_URL=http://localhost:4000
